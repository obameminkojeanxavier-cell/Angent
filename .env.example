# Django Secret Key
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DB_NAME=datahub
DB_USER=datahub_user
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# Token maître / master (tous les droits). Générer avec :
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Les agents individuels (ChatGPT, Claude, skills) reçoivent leurs propres
# tokens via : python manage.py create_agent --name ... --scopes ...
API_TOKEN=your-api-token-here

# Exiger un token pour lire les données (True) ou garder la lecture publique
# pour la page de consultation derrière Cloudflare Access (False, défaut).
REQUIRE_AUTH_FOR_READ=False

# Django Settings
DEBUG=False
ALLOWED_HOSTS=agent.co-ned.com,localhost,127.0.0.1
